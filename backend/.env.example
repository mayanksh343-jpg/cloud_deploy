# Copy to .env and fill in real values. Never commit .env.
JENKINS_URL=http://localhost:8080
JENKINS_JOB_NAME=cloud_deploy
JENKINS_USER=your-jenkins-username
JENKINS_API_TOKEN=replace-with-jenkins-api-token
FRONTEND_ORIGIN=http://localhost:5173
PORT=5002

# Required for AWS target: comma-separated owner/repo slugs reviewed by you.
# Example: ALLOWED_AWS_REPOS=your-github-owner/your-app
ALLOWED_AWS_REPOS=
